# Copier ce fichier en ".env" et le remplir. Ne JAMAIS commiter .env
ADMIN_PASSWORD=change-moi-12-caracteres-min
PORT=3000
SITE_URL=https://blacksnowdancecrew.fr
# Optionnel : identifiant de la chaîne (UC...), sinon trouvé automatiquement via @blacksnow_dancecrew
YT_CHANNEL_ID=
# Mettre 1 si le site est derrière un proxy (Nginx, Render, Railway, Alwaysdata...)
TRUST_PROXY=0
# Optionnel : dossiers persistants si l'hébergeur fournit un "volume"
# DATA_DIR=/data/json
# UPLOAD_DIR=/data/uploads
NODE_ENV=production
